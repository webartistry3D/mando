// Mando — Prisma Schema
// See PRD Section 23 for full data model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === User ===
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String   @default("")
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businessMembers BusinessMember[]
  createdBy        AuditLog[]        @relation("AuditLogUser")
}

// === Business ===
model Business {
  id              String   @id @default(cuid())
  name            String
  logoAttachmentId String?
  cacNumber       String?
  address         String?
  phone           String?
  email           String?
  createdAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members         BusinessMember[]
  settings        BusinessSettings?
  customers       Customer[]
  products        Product[]
  inventoryTxns   InventoryTransaction[]
  estimates       Estimate[]
  invoices        Invoice[]
  payments        Payment[]
  expenseCategories ExpenseCategory[]
  expenses        Expense[]
  deliveries      Delivery[]
  attachments     Attachment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
}

// === BusinessMember ===
model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  role       Role
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

// === BusinessSettings ===
model BusinessSettings {
  id                 String   @id @default(cuid())
  businessId         String   @unique
  currency           String   @default("NGN")
  invoicePrefix      String   @default("INV")
  estimatePrefix     String   @default("EST")
  deliveryPrefix     String   @default("DEL")
  taxEnabled         Boolean  @default(false)
  taxRate            Decimal  @default(0) @db.Decimal(5, 2)
  paymentInstructions String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// === Customer ===
model Customer {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  phone        String?
  email        String?
  address      String?
  customerType String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  estimates Estimate[]
  invoices  Invoice[]
  payments  Payment[]
  deliveries Delivery[]

  @@index([businessId])
}

// === Product ===
model Product {
  id                 String   @id @default(cuid())
  businessId         String
  name               String
  type               ProductType
  sku                String?
  description        String?
  sellingPrice       Decimal  @db.Decimal(12, 2)
  costPrice          Decimal  @default(0) @db.Decimal(12, 2)
  unit               String?
  taxEnabled         Boolean  @default(false)
  inventoryTracking  Boolean  @default(false)
  openingStock       Int      @default(0)
  lowStockThreshold  Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  inventoryTxns   InventoryTransaction[]
  estimateItems   EstimateItem[]
  invoiceItems    InvoiceItem[]
  deliveryItems   DeliveryItem[]

  @@index([businessId])
}

enum ProductType {
  PRODUCT
  SERVICE
}

// === InventoryTransaction ===
model InventoryTransaction {
  id            String   @id @default(cuid())
  businessId    String
  productId     String
  type          InventoryTxnType
  quantity      Int
  referenceType String?
  referenceId   String?
  reason        String?
  createdById   String?
  createdAt     DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
}

enum InventoryTxnType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

// === Estimate ===
model Estimate {
  id          String   @id @default(cuid())
  businessId  String
  customerId  String
  number      String
  status      EstimateStatus @default(DRAFT)
  issueDate   DateTime @default(now())
  expiryDate  DateTime?
  subtotal    Decimal  @default(0) @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  tax         Decimal  @default(0) @db.Decimal(12, 2)
  deliveryFee Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?
  terms       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    EstimateItem[]
  invoices Invoice[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([customerId])
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model EstimateItem {
  id          String  @id @default(cuid())
  estimateId  String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([estimateId])
}

// === Invoice ===
model Invoice {
  id                 String   @id @default(cuid())
  businessId         String
  customerId        String?
  estimateId         String?
  number             String
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime @default(now())
  dueDate            DateTime?
  subtotal           Decimal  @default(0) @db.Decimal(12, 2)
  discount           Decimal  @default(0) @db.Decimal(12, 2)
  tax                Decimal  @default(0) @db.Decimal(12, 2)
  taxRemitted         Decimal  @default(0) @db.Decimal(12, 2)
  taxRemittedAt       DateTime?
  total              Decimal  @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal  @default(0) @db.Decimal(12, 2)
  balanceDue         Decimal  @default(0) @db.Decimal(12, 2)
  notes              String?
  paymentInstructions String?
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  estimate  Estimate?     @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]
  deliveries Delivery[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([customerId])
  @@index([estimateId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @default(0) @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// === Payment ===
model Payment {
  id            String   @id @default(cuid())
  businessId    String
  invoiceId     String?
  customerId    String?
  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime @default(now())
  reference     String?
  description   String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([invoiceId])
  @@index([customerId])
}

enum PaymentMethod {
  BANK_TRANSFER
  POS
  CASH
  CARD
  OTHER
}

// === Expense ===
model ExpenseCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([businessId, name])
  @@index([businessId])
}

model Expense {
  id            String   @id @default(cuid())
  businessId    String
  categoryId    String
  description   String
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime @default(now())
  vendor        String?
  paymentMethod PaymentMethod?
  reference     String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category ExpenseCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([categoryId])
}

// === Delivery ===
model Delivery {
  id                     String   @id @default(cuid())
  businessId             String
  invoiceId              String?
  customerId             String?
  number                 String
  deliveryAddress        String?
  recipientName          String?
  recipientPhone         String?
  deliveryFee            Decimal  @default(0) @db.Decimal(12, 2)
  assignedPerson         String?
  trackingReference      String?
  status                 DeliveryStatus @default(PENDING)
  notes                  String?
  deliveredAt            DateTime?
  recipientConfirmation   String?
  proofPhotoAttachmentId String?
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice  Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    DeliveryItem[]

  @@unique([businessId, number])
  @@index([businessId])
  @@index([invoiceId])
  @@index([customerId])
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

model DeliveryItem {
  id          String  @id @default(cuid())
  deliveryId  String
  productId   String?
  description String
  quantity    Int

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
}

// === Attachment ===
model Attachment {
  id          String   @id @default(cuid())
  businessId  String
  entityType  String
  entityId    String?
  fileName    String
  mimeType    String
  fileSize    Int
  storageKey  String
  createdById String?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([entityType, entityId])
}

// === Notification ===
model Notification {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  type       String
  title      String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
}

// === AuditLog ===
model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([entityType, entityId])
}
